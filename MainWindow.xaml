<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="App1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App1"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Lemon Minecraft Launcher">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        Margin="18,0,0,0"
                        VerticalAlignment="Center">
                <!-- 应用 Logo -->
                <Image Source="ms-appx:///Assets/app-icon.png"
                       Width="24" Height="24"
                       VerticalAlignment="Center" />
                <TextBlock Text="Lemon Minecraft Launcher"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Border Style="{StaticResource PillStyle}" Padding="6,1,6,1">
                    <TextBlock x:Name="VersionText" Text="0.1 alpha" FontSize="10" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <NavigationView x:Name="NavView"
                            PaneDisplayMode="LeftCompact"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            OpenPaneLength="230"
                            CompactPaneLength="56"
                            ItemInvoked="OnNavigationItemInvoked">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="启动游戏" Tag="home" ToolTipService.ToolTip="启动游戏">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="版本下载" Tag="download" ToolTipService.ToolTip="下载并安装游戏版本">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="版本" Tag="instances" ToolTipService.ToolTip="管理已下载的游戏版本">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8FD;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="模组" Tag="store" ToolTipService.ToolTip="资源中心">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE719;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="下载" Tag="downloads" ToolTipService.ToolTip="下载任务">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE896;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="账户" Tag="accounts" ToolTipService.ToolTip="账户管理">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE77B;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="崩溃分析" Tag="crash" ToolTipService.ToolTip="崩溃分析">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE90F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <!-- 用户中心 -->
                    <NavigationViewItem Tag="usercenter" ToolTipService.ToolTip="用户中心">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE77B;" />
                        </NavigationViewItem.Icon>
                        <NavigationViewItem.Content>
                            <Grid ColumnSpacing="10" Padding="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <PersonPicture x:Name="UserCenterAvatar"
                                               Grid.Column="0"
                                               Width="30" Height="30"
                                               DisplayName="Player" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="UserCenterName"
                                               Text="未登录"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="UserCenterType"
                                               Text="点击登录或添加账户"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </NavigationViewItem.Content>
                    </NavigationViewItem>

                    <NavigationViewItem Content="设置" Tag="settings" ToolTipService.ToolTip="设置">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <Frame x:Name="ContentFrame" />
            </NavigationView>

            <!-- 全局通知 -->
            <InfoBar x:Name="NotificationBar"
                     VerticalAlignment="Bottom"
                     HorizontalAlignment="Center"
                     Margin="24,0,24,24"
                     MaxWidth="680"
                     IsOpen="False"
                     IsClosable="True"
                     Severity="Error" />
        </Grid>
    </Grid>
</Window>

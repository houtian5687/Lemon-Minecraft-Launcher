<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App1.Views.CrashPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:App1.ViewModels"
    xmlns:models="using:App1.Models"
    xmlns:converters="using:App1.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True" />
        <converters:SeverityToBrushConverter x:Key="SeverityToBrush" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14"
                    Padding="{StaticResource PagePadding}"
                    MaxWidth="980"
                    HorizontalAlignment="Center">

            <!-- ============ 日志选择 ============ -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Style="{StaticResource IconBadgeStyle}">
                            <FontIcon Glyph="&#xE90F;" FontSize="18"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="崩溃日志分析" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="自动识别内存、显卡驱动、模组冲突、Java 版本等常见问题"
                                       Style="{StaticResource HintTextStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Logs}"
                                  SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="选择要分析的日志">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:LogFileItem">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Time}" />
                                        <TextBlock Text="{Binding SizeText}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1" Content="开始分析"
                                Command="{Binding AnalyzeCommand}"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button Grid.Column="2" Content="分析最新" Command="{Binding AnalyzeLatestCommand}" />
                        <Button Grid.Column="3" Content="刷新" Command="{Binding RefreshCommand}" />
                    </Grid>

                    <ProgressBar IsIndeterminate="{Binding IsBusy}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <!-- ============ 分析结果 ============ -->
            <Border Style="{StaticResource SettingsCardStyle}"
                    Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="14">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="分析结果" Style="{StaticResource SectionTitleStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource WarningPillStyle}">
                                    <TextBlock Text="{Binding Report.Summary}"
                                               Style="{StaticResource PillTextStyle}" />
                                </Border>
                                <TextBlock Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center">
                                    <Run Text="疑似原因：" />
                                    <Run Text="{Binding Report.RootCause}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="复制报告"
                                Command="{Binding CopyReportCommand}"
                                VerticalAlignment="Top" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Report.Issues}"
                                  Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:CrashIssue">
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="16"
                                        Margin="0,0,0,10">
                                    <StackPanel Spacing="10">

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Border Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                    CornerRadius="6"
                                                    Padding="8,2,8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SeverityText}"
                                                           Style="{StaticResource PillTextStyle}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="15"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13" />

                                        <TextBlock Text="建议操作" FontWeight="SemiBold" FontSize="13" />
                                        <ItemsControl ItemsSource="{Binding Suggestions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4" ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0"
                                                                  Glyph="&#xE73E;"
                                                                  FontSize="10"
                                                                  VerticalAlignment="Top"
                                                                  Margin="0,4,0,0"
                                                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="相关日志" FontWeight="SemiBold" FontSize="13" />
                                        <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                CornerRadius="8"
                                                Padding="10">
                                            <ItemsControl ItemsSource="{Binding RelatedLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,0,0,2"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 分析完成但未匹配到已知问题 -->
                    <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                            CornerRadius="10"
                            Padding="16"
                            Visibility="{Binding HasNoIssues, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE73E;" FontSize="16"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="未匹配到已知的崩溃模式，可结合日志末尾的 Caused by 堆栈进一步排查。"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ============ 空状态 ============ -->
            <Border Style="{StaticResource SettingsCardStyle}"
                    Visibility="{Binding HasReport, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Style="{StaticResource EmptyStatePanelStyle}">
                    <FontIcon Glyph="&#xE9D9;" FontSize="42" Opacity="0.35" />
                    <TextBlock Text="未进行分析" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="请选择日志"
                               Style="{StaticResource HintTextStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <InfoBar Severity="Informational"
                     IsOpen="True"
                     Title="日志从哪里来？"
                     Message="每次启动游戏都会生成一份日志，保存在游戏目录的 game-logs 文件夹中；点击刷新可重载列表。" />
        </StackPanel>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App1.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:App1.ViewModels"
    xmlns:converters="using:App1.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="PageRoot"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True" />
        <converters:StateToBrushConverter x:Key="StateToBrush" />
    </Page.Resources>

    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ 概览 ============ -->
        <Border Grid.Row="0" Style="{StaticResource SettingsCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource IconBadgeStyle}" Margin="0,0,12,0">
                    <FontIcon Glyph="&#xE896;" FontSize="18"
                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="下载队列" Style="{StaticResource SectionTitleStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource CaptionTextStyle}" />
                        <Border Style="{StaticResource PillStyle}">
                            <TextBlock Text="{Binding SpeedText}" Style="{StaticResource PillTextStyle}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Content="清理" Command="{Binding ClearCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="打开游戏目录" Command="{Binding OpenFolderCommand}" />
            </Grid>
        </Border>

        <!-- ============ 任务组列表 ============ -->
        <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Padding="14">
            <Grid>
                <ListView ItemsSource="{Binding Groups}"
                          Background="Transparent"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:DownloadGroupSummary">
                            <Grid Padding="4,12,4,12" RowSpacing="8" MinWidth="620">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="15"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1"
                                            Background="{Binding StateKey, Converter={StaticResource StateToBrush}}"
                                            CornerRadius="6"
                                            Padding="10,3,10,3">
                                        <TextBlock Text="{Binding StateText}" FontSize="11" />
                                    </Border>
                                </Grid>

                                <ProgressBar Grid.Row="1"
                                             Value="{Binding Progress}"
                                             HorizontalAlignment="Stretch"
                                             Height="6"
                                             CornerRadius="3" />

                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding ProgressText}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding DetailText}"
                                                   Style="{StaticResource HintTextStyle}" />
                                        <TextBlock Text="{Binding SpeedText}"
                                                   Style="{StaticResource HintTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="取消"
                                            Command="{Binding DataContext.CancelGroupCommand, ElementName=PageRoot}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsFinished, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 空状态 -->
                <StackPanel Style="{StaticResource EmptyStatePanelStyle}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon Glyph="&#xE896;" FontSize="42" Opacity="0.35" />
                    <TextBlock Text="当前没有下载任务" Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Text="下载游戏版本、模组或光影时会在这里显示"
                               Style="{StaticResource HintTextStyle}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App1.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:App1.Models"
    xmlns:converters="using:App1.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="PageRoot"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧导航栏 ==================== -->
        <Border Grid.Column="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 当前使用账户的摘要 -->
                <StackPanel x:Name="NavHeader" Grid.Row="0" Padding="20,26,20,16" Spacing="16">
                    <TextBlock Text="账户" FontSize="26" FontWeight="SemiBold" />

                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="8"
                            Padding="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <PersonPicture Grid.Column="0"
                                           Width="36" Height="36"
                                           DisplayName="{Binding ActiveAccountName}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding ActiveAccountName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ActiveAccountStatus}"
                                           Style="{StaticResource SettingsRowSubtitleStyle}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 分区导航：图标 + 文字，选中项由 ListView 呈现强调色指示条 -->
                <ListView x:Name="NavList"
                          Grid.Row="1"
                          Padding="6,0,6,12"
                          Background="Transparent"
                          SelectionMode="Single"
                          SelectedIndex="{Binding NavIndex, Mode=TwoWay}"
                          SelectionChanged="OnNavSelectionChanged">
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE77B;" FontSize="16" />
                            <TextBlock x:Name="NavText0" Text="账户" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE710;" FontSize="16" />
                            <TextBlock x:Name="NavText1" Text="添加账户" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE779;" FontSize="16" />
                            <TextBlock x:Name="NavText2" Text="账户详情" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Grid>
        </Border>

        <!-- ==================== 右侧内容区 ==================== -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch">
            <!-- 内容列最多 860px 且靠左，右侧自动留白；
                 避免宽窗口下 Stretch+MaxWidth 被退化为居中，使内容看起来偏右 -->
            <Grid Padding="{StaticResource PagePadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="860" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ========== 分区 1：账户列表 ========== -->
                <StackPanel x:Name="PanelAccounts"
                            Spacing="16" VerticalAlignment="Top"
                            Visibility="{Binding IsAccountsTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>

                    <TextBlock Text="账户" Style="{StaticResource PageTitleStyle}" FontSize="28" />

                    <Border Style="{StaticResource AccountsCardStyle}" Translation="0,0,16">
                        <StackPanel Spacing="14">
                            <TextBlock Text="已保存的账户" Style="{StaticResource SectionTitleStyle}" />

                            <ListView ItemsSource="{Binding Accounts}"
                                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                                      MinHeight="120"
                                      Background="Transparent"
                                      SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="CornerRadius" Value="6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Account">
                                        <Grid Padding="2,8,2,8" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <PersonPicture Grid.Column="0"
                                                           DisplayName="{Binding PlayerName}"
                                                           Width="44" Height="44" />

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold" />
                                                    <Border Style="{StaticResource PillStyle}">
                                                        <TextBlock Text="{Binding TypeText}"
                                                                   Style="{StaticResource PillTextStyle}" />
                                                    </Border>
                                                    <Border Style="{StaticResource SuccessPillStyle}"
                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="当前使用" Style="{StaticResource PillTextStyle}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding StatusText}"
                                                           Style="{StaticResource SettingsRowSubtitleStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 空列表提示 -->
                            <StackPanel Spacing="6"
                                        Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="还没有任何账户" FontWeight="SemiBold" />
                                <TextBlock Text="切换到「添加账户」即可登录微软账户或创建离线账户。"
                                           Style="{StaticResource SettingsRowSubtitleStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 选中账户的操作 -->
                    <Border Style="{StaticResource AccountsCardStyle}" Translation="0,0,16"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="账户操作" Style="{StaticResource SectionTitleStyle}" />

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="设为当前账户"
                                        Command="{Binding SetActiveCommand}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="刷新登录令牌" Command="{Binding RefreshCommand}" />
                                <Button Content="删除账户" Command="{Binding RemoveCommand}" />
                            </StackPanel>

                            <ProgressBar IsIndeterminate="{Binding IsBusy}"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding StatusText}"
                                       Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== 分区 2：添加账户 ========== -->
                <StackPanel x:Name="PanelAdd"
                            Spacing="16" VerticalAlignment="Top"
                            Visibility="{Binding IsAddTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>

                    <TextBlock Text="添加账户" Style="{StaticResource PageTitleStyle}" FontSize="28" />

                    <Border Style="{StaticResource AccountsCardStyle}" Translation="0,0,16">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource IconBadgeStyle}">
                                    <FontIcon Glyph="&#xE8AF;" FontSize="18"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="微软账户" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                            </Grid>

                            <Button Content="登录微软账户"
                                    Command="{Binding LoginMicrosoftCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" />

                            
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AccountsCardStyle}" Translation="0,0,16">
                        <StackPanel Spacing="14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource IconBadgeStyle}">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="18"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="离线账户" Style="{StaticResource SectionTitleStyle}" />
                                   
                                </StackPanel>
                            </Grid>

                            <Button Content="添加离线账户"
                                    Command="{Binding AddOfflineCommand}"
                                    HorizontalAlignment="Stretch" />

                            <TextBlock TextWrapping="Wrap"
                                       Style="{StaticResource SettingsRowSubtitleStyle}"
                                       Text="离线账户无法进入开启正版验证的服务器" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AccountsCardStyle}" Translation="0,0,16"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="10">
                            <ProgressBar IsIndeterminate="True" />
                            <TextBlock Text="{Binding StatusText}"
                                       Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ========== 分区 3：账户详情 ========== -->
                <StackPanel x:Name="PanelDetail"
                            Spacing="16" VerticalAlignment="Top"
                            Visibility="{Binding IsDetailTab, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel.RenderTransform>
                        <TranslateTransform />
                    </StackPanel.RenderTransform>

                    <TextBlock Text="账户详情" Style="{StaticResource PageTitleStyle}" FontSize="28" />

                    <Border Style="{StaticResource AccountsCardStyle}" Translation="0,0,16"
                            Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="尚未选择账户" FontWeight="SemiBold" />
                            <TextBlock Text="请先在「账户」分区中从列表里选中一个账户。"
                                       Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource AccountsCardStyle}" Translation="0,0,16"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Spacing="18">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <PersonPicture Grid.Column="0"
                                               Width="56" Height="56"
                                               DisplayName="{Binding Selected.PlayerName}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="{Binding Selected.PlayerName}"
                                               FontSize="20" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Style="{StaticResource PillStyle}">
                                            <TextBlock Text="{Binding Selected.TypeText}"
                                                       Style="{StaticResource PillTextStyle}" />
                                        </Border>
                                        <Border Style="{StaticResource SuccessPillStyle}"
                                                Visibility="{Binding Selected.IsActive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="当前使用" Style="{StaticResource PillTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}" Padding="0,12,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8D7;" Style="{StaticResource SettingsRowIconStyle}" />
                                    <TextBlock Grid.Column="1" Text="账户类型" VerticalAlignment="Center"
                                               Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Selected.TypeText}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>

                                <Border Style="{StaticResource SettingsRowDividerStyle}" />

                                <Grid Style="{StaticResource SettingsRowStyle}" Padding="0,12,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE930;" Style="{StaticResource SettingsRowIconStyle}" />
                                    <TextBlock Grid.Column="1" Text="登录状态" VerticalAlignment="Center"
                                               Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Selected.StatusText}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <Border Style="{StaticResource SettingsRowDividerStyle}" />

                                <Grid Style="{StaticResource SettingsRowStyle}" Padding="0,12,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE8FD;" Style="{StaticResource SettingsRowIconStyle}" />
                                    <TextBlock Grid.Column="1" Text="玩家 UUID" VerticalAlignment="Center"
                                               Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedUuidText}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               Style="{StaticResource MonoTextStyle}" />
                                </Grid>

                                <Border Style="{StaticResource SettingsRowDividerStyle}" />

                                <Grid Style="{StaticResource SettingsRowStyle}" Padding="0,12,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE823;" Style="{StaticResource SettingsRowIconStyle}" />
                                    <TextBlock Grid.Column="1" Text="令牌到期时间" VerticalAlignment="Center"
                                               Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedExpiresText}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>

                                <Border Style="{StaticResource SettingsRowDividerStyle}" />

                                <Grid Style="{StaticResource SettingsRowStyle}" Padding="0,12,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7FC;" Style="{StaticResource SettingsRowIconStyle}" />
                                    <TextBlock Grid.Column="1" Text="游戏授权" VerticalAlignment="Center"
                                               Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedOwnsGameText}"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="设为当前账户"
                                        Command="{Binding SetActiveCommand}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="刷新登录令牌" Command="{Binding RefreshCommand}" />
                                <Button Content="删除账户" Command="{Binding RemoveCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>

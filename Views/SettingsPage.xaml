<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App1.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:App1.Models"
    xmlns:converters="using:App1.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToOnOffConverter x:Key="BoolToOnOff" />
        <converters:ClampWidthConverter x:Key="ClampWidth" />

        <!--
          主设置页的分类入口行：整行可点，悬停时按系统样式轻微变色。
          行高比子页的设置行略大，让主页面在全屏下有足够的视觉重量。
        -->
        <Style x:Key="SettingsNavRowStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16,18,16,18" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <!-- 页面底衬：Windows 设置使用浅灰底与白色卡片形成对比 -->
    <Grid Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          面包屑导航。
          BreadcrumbBar 是 WinUI 原生控件：自带「›」分隔符与溢出折叠，
          窄窗口时靠前的层级会自动收进「…」菜单，满足响应式要求。
          最后一级为当前页，点击不做跳转。
        -->
        <BreadcrumbBar x:Name="NavBreadcrumb"
                       Grid.Row="0"
                       Margin="24,16,24,2"
                       ItemClicked="OnBreadcrumbItemClicked" />

        <!-- HorizontalContentAlignment 必须为 Stretch：ScrollViewer 默认是 Left，
             会导致内部内容不被拉伸（宽度收缩到内容宽度），行尾控件无法右对齐 -->
        <ScrollViewer x:Name="MainScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch">
            <!--
              内容铺满可用宽度（上限 1600）。
              左对齐而非居中，避免左侧导航栏造成的视觉偏右；
              上限放宽到 1600 是为了让全屏时卡片真正铺开，
              不再只占中间一条、两侧留出大片空白。
              分组间距取 16 保持紧凑，不做无意义的拉大。
            -->
            <StackPanel Padding="{StaticResource PagePadding}"
                        HorizontalAlignment="Left"
                        Width="{Binding ViewportWidth, ElementName=MainScroll, Converter={StaticResource ClampWidth}, ConverterParameter=1600}"
                        Spacing="16">

                <!-- ==================== 主设置页：分类入口 ==================== -->
                <StackPanel x:Name="ViewRoot" Spacing="16">
                    <TextBlock Text="设置"
                               Style="{StaticResource PageTitleStyle}"
                               FontSize="28"
                               Margin="2,0,0,6" />

                    <!--
                      概览卡片：仿 Windows 11 设置页顶部的设备卡。
                      全屏时先给一个信息锚点，避免标题下方直接是一长条空白。
                    -->
                    <Border Style="{StaticResource SettingsGroupCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="56" Height="56"
                                    CornerRadius="10"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Image Source="ms-appx:///Assets/app-icon.png" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="Lemon Minecraft Launcher" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource SettingsRowSubtitleStyle}">
                                    <Run Text="当前版本 " />
                                    <Run Text="{Binding CurrentVersion}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupCardStyle}" Padding="0">
                        <StackPanel>
                            <Button Style="{StaticResource SettingsNavRowStyle}" Tag="launch" Click="OnSectionClick">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE768;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="启动设置" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Button>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <Button Style="{StaticResource SettingsNavRowStyle}" Tag="game" Click="OnSectionClick">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE7FC;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="游戏设置" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Button>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <Button Style="{StaticResource SettingsNavRowStyle}" Tag="java" Click="OnSectionClick">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE950;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Java 设置" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Button>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <Button Style="{StaticResource SettingsNavRowStyle}" Tag="ui" Click="OnSectionClick">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="界面设置" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Button>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <Button Style="{StaticResource SettingsNavRowStyle}" Tag="download" Click="OnSectionClick">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="下载设置" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Button>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <Button Style="{StaticResource SettingsNavRowStyle}" Tag="advanced" Click="OnSectionClick">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE713;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="高级设置" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Button>
                            <Border Style="{StaticResource SettingsRowDividerStyle}" />

                            <Button Style="{StaticResource SettingsNavRowStyle}" Tag="about" Click="OnSectionClick">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="关于" VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== 子页：启动设置 ==================== -->
                <StackPanel x:Name="ViewLaunch" Spacing="16" Visibility="Collapsed">

            <!-- ============ 启动设置 ============ -->
            <TextBlock Text="启动设置" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7C4;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="最小内存" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="游戏启动时申请的初始内存（MB）" Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <NumberBox Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   Width="130"
                                   Minimum="256" Maximum="16384"
                                   SpinButtonPlacementMode="Inline"
                                   VerticalAlignment="Center"
                                   Value="{Binding Settings.DefaultMinMemoryMb, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7C4;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="最大内存" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="游戏可使用的内存上限（MB），建议不超过物理内存的一半"
                                       Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <NumberBox Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   Width="130"
                                   Minimum="512" Maximum="32768"
                                   SpinButtonPlacementMode="Inline"
                                   VerticalAlignment="Center"
                                   Value="{Binding Settings.DefaultMaxMemoryMb, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7E8;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="启动游戏后关闭启动器" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="游戏成功启动后自动退出启动器界面" Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{Binding Settings.CloseOnLaunch, Converter={StaticResource BoolToOnOff}}" />
                            <ToggleSwitch MinWidth="0"
                                          Margin="0,0,-12,0"
                                          OnContent=""
                                          OffContent=""
                                          IsOn="{Binding Settings.CloseOnLaunch, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE756;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="显示游戏日志" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="新实例默认显示游戏的实时输出窗口"
                                       Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{Binding Settings.ShowGameConsole, Converter={StaticResource BoolToOnOff}}" />
                            <ToggleSwitch MinWidth="0"
                                          Margin="0,0,-12,0"
                                          OnContent=""
                                          OffContent=""
                                          IsOn="{Binding Settings.ShowGameConsole, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
                </StackPanel>

                <!-- ==================== 子页：游戏设置 ==================== -->
                <StackPanel x:Name="ViewGame" Spacing="16" Visibility="Collapsed">

            <!-- ============ 游戏设置 ============ -->
            <TextBlock Text="游戏设置" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B7;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="游戏目录" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding GameDirectory}"
                                       Style="{StaticResource SettingsRowSubtitleStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="浏览…" VerticalAlignment="Center"
                                Command="{Binding BrowseGameDirCommand}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7B8;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="存储与日志" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding StorageUsageText}" Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="打开目录" Command="{Binding OpenGameDirCommand}" />
                            <Button Content="日志" Command="{Binding OpenLogDirCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE946;" Style="{StaticResource SettingsRowIconStyle}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource SettingsRowSubtitleStyle}"
                                   Text="更改游戏目录后，已有版本需要手动迁移，新下载的版本会安装到新目录。" />
                    </Grid>
                </StackPanel>
            </Border>
                </StackPanel>

                <!-- ==================== 子页：Java 设置 ==================== -->
                <StackPanel x:Name="ViewJava" Spacing="16" Visibility="Collapsed">

            <!-- ============ Java 设置 ============ -->
            <TextBlock Text="Java 设置" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE950;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="默认 Java" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="启动游戏时优先使用的运行环境" Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  MinWidth="230"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding JavaList}"
                                  SelectedItem="{Binding SelectedJava, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:JavaInfo">
                                    <TextBlock Text="{Binding DisplayText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8EF;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="自动选择 Java" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="未指定时按游戏版本自动匹配（1.20.5 及以上需要 Java 21）"
                                       Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{Binding Settings.AutoSelectJava, Converter={StaticResource BoolToOnOff}}" />
                            <ToggleSwitch MinWidth="0"
                                          Margin="0,0,-12,0"
                                          OnContent=""
                                          OffContent=""
                                          IsOn="{Binding Settings.AutoSelectJava, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE721;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Java 管理" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding JavaStatus}" Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="54,0,16,12" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="重新扫描" Command="{Binding ScanJavaCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="安装 Java 8" Command="{Binding InstallJavaCommand}" CommandParameter="8" />
                            <Button Content="安装 Java 17" Command="{Binding InstallJavaCommand}" CommandParameter="17" />
                            <Button Content="安装 Java 21" Command="{Binding InstallJavaCommand}" CommandParameter="21" />
                        </StackPanel>
                        <ProgressBar IsIndeterminate="{Binding IsBusy}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                     HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8E5;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="手动指定" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="自动扫描没有找到你的 Java 时，可手动选择 java.exe 或安装目录"
                                       Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="54,0,16,12" Orientation="Horizontal" Spacing="8">
                        <Button Content="选择 java.exe…" Command="{Binding AddJavaFileCommand}" />
                        <Button Content="选择目录…" Command="{Binding AddJavaFolderCommand}" />
                        <Button Content="移除手动项"
                                Command="{Binding RemoveJavaCommand}"
                                CommandParameter="{Binding SelectedJava}" />
                    </StackPanel>
                </StackPanel>
            </Border>
                </StackPanel>

                <!-- ==================== 子页：界面设置 ==================== -->
                <StackPanel x:Name="ViewUi" Spacing="16" Visibility="Collapsed">

            <!-- ============ 界面设置 ============ -->
            <TextBlock Text="界面设置" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE790;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="主题模式" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="启动器的明暗外观" Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="2"
                                  MinWidth="150"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Themes}"
                                  SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"
                                  DisplayMemberPath="Name" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE945;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="界面动画" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="页面切换与列表的过渡动效" Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{Binding Settings.EnableAnimations, Converter={StaticResource BoolToOnOff}}" />
                            <ToggleSwitch MinWidth="0"
                                          Margin="0,0,-12,0"
                                          OnContent=""
                                          OffContent=""
                                          IsOn="{Binding Settings.EnableAnimations, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE740;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="启动器窗口大小" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="下次打开启动器时生效"
                                       Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <NumberBox Width="92"
                                       Minimum="800" Maximum="7680"
                                       SpinButtonPlacementMode="Inline"
                                       Value="{Binding Settings.DefaultWindowWidth, Mode=TwoWay}" />
                            <TextBlock Text="×" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <NumberBox Width="92"
                                       Minimum="600" Maximum="4320"
                                       SpinButtonPlacementMode="Inline"
                                       Value="{Binding Settings.DefaultWindowHeight, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
                </StackPanel>

                <!-- ==================== 子页：下载设置 ==================== -->
                <StackPanel x:Name="ViewDownload" Spacing="16" Visibility="Collapsed">

            <!-- ============ 下载设置 ============ -->
            <TextBlock Text="下载设置" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE753;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="使用镜像源加速" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="大陆网络推荐开启"
                                       Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{Binding Settings.UseBmclApiMirror, Converter={StaticResource BoolToOnOff}}" />
                            <ToggleSwitch MinWidth="0"
                                          Margin="0,0,-12,0"
                                          OnContent=""
                                          OffContent=""
                                          IsOn="{Binding Settings.UseBmclApiMirror, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE946;" Style="{StaticResource SettingsRowIconStyle}" />
                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource SettingsRowSubtitleStyle}"
                                   Text="下载速度可能低于官方源" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE896;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="下载线程数" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="同时下载的文件数量" Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <NumberBox Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   Width="130"
                                   Minimum="1" Maximum="32"
                                   SpinButtonPlacementMode="Inline"
                                   VerticalAlignment="Center"
                                   Value="{Binding Settings.MaxConcurrentDownloads, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE9D9;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="下载速度限制" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="0 表示不限速" Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <NumberBox Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   Width="130"
                                   Minimum="0" Maximum="102400"
                                   SpinButtonPlacementMode="Inline"
                                   VerticalAlignment="Center"
                                   Value="{Binding Settings.SpeedLimitKb, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE719;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="资源检索源" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding CurseForgeStatusText}"
                                       Style="{StaticResource SettingsRowSubtitleStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SuccessPillStyle}">
                            <TextBlock Text="Modrinth 可用" Style="{StaticResource PillTextStyle}" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                    </Grid>
                </StackPanel>
            </Border>
                </StackPanel>

                <!-- ==================== 子页：高级设置 ==================== -->
                <StackPanel x:Name="ViewAdvanced" Spacing="16" Visibility="Collapsed">

            <!-- ============ 高级设置 ============ -->
            <TextBlock Text="高级设置" Style="{StaticResource SettingsGroupHeaderStyle}" />
            <Border Style="{StaticResource SettingsGroupCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE8B5;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="分块线程数" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="单个大文件拆分为多个连接并行下载" Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <NumberBox Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   Width="130"
                                   Minimum="1" Maximum="16"
                                   SpinButtonPlacementMode="Inline"
                                   VerticalAlignment="Center"
                                   Value="{Binding Settings.ChunkCount, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7C1;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="分块阈值" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="超过该大小才启用分块下载（MB）" Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <NumberBox Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   Width="130"
                                   Minimum="1" Maximum="1024"
                                   SpinButtonPlacementMode="Inline"
                                   VerticalAlignment="Center"
                                   Value="{Binding Settings.ChunkThresholdMb, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE7C1;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="自动检查更新" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="启动启动器时检查新版本" Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="12"
                                       VerticalAlignment="Center"
                                       Text="{Binding Settings.AutoCheckUpdate, Converter={StaticResource BoolToOnOff}}" />
                            <ToggleSwitch MinWidth="0"
                                          Margin="0,0,-12,0"
                                          OnContent=""
                                          OffContent=""
                                          IsOn="{Binding Settings.AutoCheckUpdate, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDividerStyle}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE72C;" Style="{StaticResource SettingsRowIconStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="手动更新" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="立即检查新版本，或应用已下载的增量补丁"
                                       Style="{StaticResource SettingsRowSubtitleStyle}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="54,0,16,12" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="检查更新" Command="{Binding CheckUpdateCommand}" />
                            <Button Content="应用更新" Command="{Binding ApplyUpdateCommand}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="重启启动器" Click="OnRestartClick" />
                        </StackPanel>
                        <ProgressBar Value="{Binding UpdateProgress}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding UpdateText}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
                </StackPanel>

                <!-- ==================== 子页：关于 ==================== -->
                <StackPanel x:Name="ViewAbout" Spacing="16" Visibility="Collapsed">

            <!-- ============ 关于 ============ -->
            <StackPanel Margin="4,10,0,0" Spacing="10">
                <TextBlock Text="关于" Style="{StaticResource SettingsGroupHeaderStyle}" Margin="0" />

                <StackPanel Spacing="2">
                    <TextBlock>
                        <Run Text="Lemon Minecraft Launcher " />
                        <Run Text="{Binding CurrentVersion}" />
                    </TextBlock>
                    <TextBlock Text="Copyright © 2026 Lemon. 保留一切权利。"
                               Style="{StaticResource SettingsRowSubtitleStyle}" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <HyperlinkButton Content="项目主页" Padding="0" Click="OnHomepageClick" />
                    <HyperlinkButton Content="打开日志目录" Padding="0" Command="{Binding OpenLogDirCommand}" />
                </StackPanel>
            </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App1.Views.InstancesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:App1.Models"
    xmlns:converters="using:App1.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="PageRoot"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Inverse="True" />
    </Page.Resources>

    <Grid Padding="20" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 游戏版本列表 ============ -->
        <Border Grid.Column="0" Style="{StaticResource SettingsCardStyle}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="已下载的版本" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text=""
                                   Style="{StaticResource HintTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding NewInstanceCommand}"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="14" />
                            <TextBlock Text="下载版本" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Instances}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          SelectionMode="Single"
                          Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:GameInstance">
                            <Grid Padding="2,8,2,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        CornerRadius="10"
                                        VerticalAlignment="Top"
                                        Background="Transparent">
                                    <FontIcon Glyph="&#xE7FC;" FontSize="20"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Style="{StaticResource PillStyle}">
                                            <TextBlock Text="{Binding VersionText}"
                                                       Style="{StaticResource PillTextStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintTextStyle}">
                                        <Run Text="游玩时长 " />
                                        <Run Text="{Binding PlayTimeText}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ============ 版本设置 ============ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">

                <!-- 未选中提示 -->
                <Border Style="{StaticResource SettingsCardStyle}"
                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel Style="{StaticResource EmptyStatePanelStyle}">
                        <FontIcon Glyph="&#xE7FC;" FontSize="44" Opacity="0.35" />
                        <TextBlock Text="选择左侧游戏版本以查看和修改设置" Style="{StaticResource CaptionTextStyle}" />
                        <Button Content="前往下载新版本"
                                Command="{Binding NewInstanceCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="14" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="18"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Border>
                                <TextBlock Text="基本信息" Style="{StaticResource SectionTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBox Header="版本名称" Text="{Binding EditName, Mode=TwoWay}" />
                            <TextBox Header="备注"
                                     Text="{Binding EditNotes, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     MinHeight="72"
                                     PlaceholderText="例如：1.20.1 生存档，含 40 个模组" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="保存设置" Command="{Binding SaveCommand}"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Button Content="复制版本" Command="{Binding CloneCommand}" />
                                <Button Content="打开目录" Command="{Binding OpenFolderCommand}" />
                                <Button Content="修复安装" Command="{Binding RepairCommand}" />
                                <Button Content="删除版本" Command="{Binding DeleteCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <FontIcon Glyph="&#xE950;" FontSize="18"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Border>
                                <TextBlock Text="内存与 Java" Style="{StaticResource SectionTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <NumberBox Header="最小内存（MB）"
                                           Value="{Binding EditMinMemory, Mode=TwoWay}"
                                           Minimum="256" Maximum="16384"
                                           SpinButtonPlacementMode="Inline"
                                           Width="200" />
                                <NumberBox Header="最大内存（MB）"
                                           Value="{Binding EditMaxMemory, Mode=TwoWay}"
                                           Minimum="512" Maximum="32768"
                                           SpinButtonPlacementMode="Inline"
                                           Width="200" />
                            </StackPanel>

                            <ComboBox Header="Java 运行时"
                                      ItemsSource="{Binding JavaList}"
                                      SelectedValuePath="Path"
                                      SelectedValue="{Binding EditJavaPath, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:JavaInfo">
                                        <TextBlock Text="{Binding DisplayText}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBox Header="自定义 JVM 参数"
                                     Text="{Binding EditJvmArguments, Mode=TwoWay}"
                                     PlaceholderText="例如：-XX:+UseZGC -Dfile.encoding=UTF-8" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Style="{StaticResource IconBadgeStyle}">
                                    <FontIcon Glyph="&#xE7F4;" FontSize="18"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                </Border>
                                <TextBlock Text="窗口设置" Style="{StaticResource SectionTitleStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <ComboBox Header="窗口模式"
                                      SelectedIndex="{Binding EditWindowMode, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="系统默认" />
                                <ComboBoxItem Content="自定义尺寸" />
                                <ComboBoxItem Content="全屏" />
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <NumberBox Header="宽度" Value="{Binding EditWidth, Mode=TwoWay}"
                                           Minimum="320" Maximum="7680" Width="180" />
                                <NumberBox Header="高度" Value="{Binding EditHeight, Mode=TwoWay}"
                                           Minimum="240" Maximum="4320" Width="180" />
                            </StackPanel>

                            <ToggleSwitch Header="显示游戏控制台窗口"
                                          IsOn="{Binding EditShowConsole, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <Border Style="{StaticResource IconBadgeStyle}">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="18"
                                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    </Border>
                                    <TextBlock Text="已安装资源" Style="{StaticResource SectionTitleStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshResourcesCommand}" />
                            </Grid>

                            <ListView ItemsSource="{Binding Resources}"
                                      MinHeight="80"
                                      Background="Transparent"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:InstalledResource">
                                        <Grid Padding="2,6,2,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FileName}"
                                                           Style="{StaticResource HintTextStyle}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="启用 / 禁用"
                                                    Command="{Binding DataContext.ToggleInstalledCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="2"
                                                    Content="删除"
                                                    Margin="8,0,0,0"
                                                    Command="{Binding DataContext.RemoveInstalledCommand, ElementName=PageRoot}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

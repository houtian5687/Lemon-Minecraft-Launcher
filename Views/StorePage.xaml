<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App1.Views.StorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:App1.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="PageRoot"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:PlatformToBrushConverter x:Key="PlatformToBrush" />

        <!--
          Hero 辅助卡：封面图 + 底部标题浮层。
          供右上大卡与右下两个小卡复用（内容由 ContentControl 注入）。
        -->
        <DataTemplate x:Key="HeroTileTemplate">
            <Border CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Tapped="OnHeroTileTapped">
                <Grid>
                    <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" />

                    <Border VerticalAlignment="Bottom" Height="84">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#E6000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel VerticalAlignment="Bottom" Padding="14" Spacing="6">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Content="{Binding PrimaryCategoryText}"
                                Click="OnCategoryTagClick"
                                Style="{StaticResource OverlayTagButtonStyle}"
                                HorizontalAlignment="Left"
                                ToolTipService.ToolTip="查看该分类下的更多资源" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--
          商店卡片：左图标 + 名称/关注数与分类 + 右下下载量。
          对应「最畅销的应用」那种横向小卡。
        -->
        <DataTemplate x:Key="AppTileTemplate">
            <Border Height="104"
                    CornerRadius="6"
                    Padding="12"
                    HorizontalAlignment="Stretch"
                    Tapped="OnTileTapped"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Column="0"
                            Grid.RowSpan="2"
                            Width="52" Height="52"
                            CornerRadius="10"
                            VerticalAlignment="Top"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                    </Border>

                    <!-- 第一行：名称 + 数据源徽标（标明来自 Modrinth / CurseForge） -->
                    <Grid Grid.Column="1" Grid.Row="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />

                        <Border Grid.Column="1"
                                Style="{StaticResource SourceBadgeStyle}"
                                Background="{Binding Platform, Converter={StaticResource PlatformToBrush}}"
                                ToolTipService.ToolTip="{Binding SourceTipText}">
                            <TextBlock Text="{Binding PlatformText}"
                                       FontSize="10"
                                       Foreground="White" />
                        </Border>
                    </Grid>

                    <!-- 第二行：分类标签（可点击）+ 加载器标签 + 下载量 -->
                    <Grid Grid.Column="1" Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="{Binding PrimaryCategoryText}"
                                Click="OnCategoryTagClick"
                                Style="{StaticResource TagButtonStyle}"
                                ToolTipService.ToolTip="查看该分类下的更多资源" />

                        <Button Grid.Column="1"
                                Content="{Binding PrimaryLoaderText}"
                                Click="OnLoaderTagClick"
                                Style="{StaticResource TagButtonStyle}"
                                ToolTipService.ToolTip="查看使用该加载器的资源" />

                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   ToolTipService.ToolTip="下载量">
                            <Run Text="↓ " />
                            <Run Text="{Binding DownloadsText}" />
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏：左上角页面标题 + 右上角搜索入口 ==================== -->
        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="模组"
                       Style="{StaticResource PageTitleStyle}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center" />

            <Grid Grid.Column="1" Width="360" VerticalAlignment="Center">
                <TextBox x:Name="StoreSearchBox"
                         PlaceholderText="搜索模组、整合包、光影、材质包…"
                         Text="{Binding Query, Mode=TwoWay}"
                         Height="34"
                         Padding="32,0,8,0"
                         VerticalContentAlignment="Center"
                         KeyDown="OnSearchKeyDown"
                         GotFocus="OnSearchBoxGotFocus" />
                <FontIcon Glyph="&#xE721;"
                          FontSize="14"
                          Margin="10,0,0,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <Button Grid.Column="2"
                    Height="34"
                    VerticalAlignment="Center"
                    Click="OnSearchClick"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="在搜索页中查询">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE721;" FontSize="13" />
                    <TextBlock Text="搜索" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ==================== 商店内容 ==================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" Padding="2,2,2,8">

                <ProgressRing IsActive="{Binding IsLoadingDiscover}"
                              Width="32" Height="32"
                              HorizontalAlignment="Center" />

                <!-- ========== Hero：一大多小 ========== -->
                <Grid Height="308" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>

                    <!-- 主推大卡 -->
                    <Border Grid.Column="0"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Tapped="OnHeroMainTapped">
                        <Grid>
                            <Image Source="{Binding HeroMain.CoverUrl}" Stretch="UniformToFill" />

                            <Border VerticalAlignment="Bottom" Height="220">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#D9000000" Offset="0.55" />
                                        <GradientStop Color="#F2000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <StackPanel VerticalAlignment="Bottom" Padding="26" Spacing="10">
                                <Border HorizontalAlignment="Left"
                                        CornerRadius="4"
                                        Padding="8,3,8,3"
                                        Background="#66000000">
                                    <TextBlock Text="精选推荐"
                                               FontSize="11"
                                               Foreground="White" />
                                </Border>

                                <TextBlock Text="{Binding HeroMain.Name}"
                                           FontSize="28"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           MaxLines="1"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{Binding HeroMain.Summary}"
                                           FontSize="13"
                                           Foreground="#E6FFFFFF"
                                           MaxLines="2"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" />

                                <Button Click="OnHeroMainClick"
                                        HorizontalAlignment="Left"
                                        MinWidth="132"
                                        Background="#FFFFFF"
                                        Foreground="#1A1A1A"
                                        BorderThickness="0"
                                        Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE896;" FontSize="14" Foreground="#1A1A1A" />
                                        <TextBlock Text="查看详情" Foreground="#1A1A1A" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 右侧：一上一双 -->
                    <Grid Grid.Column="1" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.35*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <ContentControl Grid.Row="0"
                                        Content="{Binding HeroSide}"
                                        ContentTemplate="{StaticResource HeroTileTemplate}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />

                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ContentControl Grid.Column="0"
                                            Content="{Binding HeroSmall1}"
                                            ContentTemplate="{StaticResource HeroTileTemplate}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch" />

                            <ContentControl Grid.Column="1"
                                            Content="{Binding HeroSmall2}"
                                            ContentTemplate="{StaticResource HeroTileTemplate}"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ========== 类别入口：点击任一项进入该类别独立页 ========== -->
                <ScrollViewer HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}"
                                        Click="OnCategoryChipClick"
                                        Style="{StaticResource CategoryChipStyle}"
                                        ToolTipService.ToolTip="进入该类别页面，查看其中的全部模组" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- ========== 热门下载 ========== -->
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="热门下载"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                        <HyperlinkButton Grid.Column="1"
                                         Click="OnBrowsePopularClick"
                                         ToolTipService.ToolTip="在搜索页中查看更多">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="查看更多" FontSize="12" />
                                <FontIcon Glyph="&#xE76C;" FontSize="11" />
                            </StackPanel>
                        </HyperlinkButton>
                    </Grid>

                    <!--
                      用 UniformGrid 固定 4 列：卡片宽度随窗口自适应，
                      避免全屏时列数变化导致最后一行残缺、留白。
                    -->
                    <GridView x:Name="PopularGrid"
                              ItemsSource="{Binding Popular}"
                              ItemTemplate="{StaticResource AppTileTemplate}"
                              SelectionMode="None"
                              Background="Transparent"
                              Padding="0"
                              SizeChanged="OnTileGridSizeChanged">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,12,12" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>
                </StackPanel>

                <!-- ========== 最近更新 ========== -->
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="最近更新"
                                   Style="{StaticResource SectionTitleStyle}"
                                   VerticalAlignment="Center" />
                        <HyperlinkButton Grid.Column="1"
                                         Click="OnBrowseLatestClick"
                                         ToolTipService.ToolTip="在搜索页中查看更多">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="查看更多" FontSize="12" />
                                <FontIcon Glyph="&#xE76C;" FontSize="11" />
                            </StackPanel>
                        </HyperlinkButton>
                    </Grid>

                    <GridView x:Name="LatestGrid"
                              ItemsSource="{Binding Latest}"
                              ItemTemplate="{StaticResource AppTileTemplate}"
                              SelectionMode="None"
                              Background="Transparent"
                              Padding="0"
                              SizeChanged="OnTileGridSizeChanged">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="CornerRadius" Value="6" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,12,12" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </GridView.ItemContainerStyle>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App1.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:App1.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid>
        <!-- ============ 背景图（每次启动轮换一张） ============ -->
        <Image x:Name="BackgroundImage"
               Stretch="UniformToFill"
               Opacity="0.45" />

        <!-- 主题色遮罩：保证前景文字与卡片在任何底图上都清晰可读 -->
        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Opacity="0.35" />

        <!-- ============ 中部：缺少版本 / 账户时的引导 ============ -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="440"
                    Spacing="12"
                    Padding="24"
                    Visibility="{Binding ShowHint, Converter={StaticResource BoolToVisibility}}">
            <FontIcon Glyph="&#xE946;"
                      FontSize="44"
                      Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
            <TextBlock Text="{Binding HintTitle}"
                       Style="{StaticResource PageTitleStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding HintText}"
                       Style="{StaticResource CaptionTextStyle}"
                       TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Content="前往下载"
                        Click="OnGoDownloadClick"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{Binding MissingInstance, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="前往账户"
                        Click="OnGoAccountClick"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{Binding MissingAccount, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </StackPanel>

        <!-- ============ 右下角：版本选择 + 启动（融合为一个按钮） ============ -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,28,28"
                Padding="16,14"
                MinWidth="360"
                CornerRadius="14"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel Spacing="10">
                <!-- 当前版本与账户摘要 -->
                <TextBlock Text="{Binding SelectionSummary}"
                           Style="{StaticResource HintTextStyle}"
                           TextTrimming="CharacterEllipsis" />

                <Grid ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 主体：启动游戏（与右侧下拉连成一个整体按钮） -->
                    <Button Grid.Column="0"
                            x:Name="LaunchButton"
                            Command="{Binding LaunchCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            CornerRadius="10,0,0,10"
                            AutomationProperties.Name="{Binding LaunchButtonText}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE768;" FontSize="16" />
                            <TextBlock Text="{Binding LaunchButtonText}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <!-- 右侧：展开游戏版本列表（启动中 / 运行中与主体一起禁用变灰） -->
                    <Button Grid.Column="1"
                            Width="46"
                            Height="52"
                            Padding="0"
                            CornerRadius="0,10,10,0"
                            Style="{StaticResource AccentButtonStyle}"
                            IsEnabled="{Binding CanSwitchVersion}"
                            AutomationProperties.Name="切换版本"
                            ToolTipService.ToolTip="切换版本">
                        <Button.Flyout>
                            <MenuFlyout x:Name="VersionFlyout"
                                        Placement="TopEdgeAlignedRight"
                                        Opening="OnVersionFlyoutOpening" />
                        </Button.Flyout>
                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    </Button>

                    <Button Grid.Column="2"
                            Height="52"
                            Margin="8,0,0,0"
                            CornerRadius="10"
                            VerticalAlignment="Center"
                            Command="{Binding KillCommand}"
                            Visibility="{Binding CanKill, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71A;" FontSize="14" />
                            <TextBlock Text="{Binding KillButtonText}" />
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </Border>

        <!--
          启动状态气泡：取代原先叠在启动按钮下方的文字提示。
          用 TeachingTip 挂在启动按钮上方，并关闭轻触消失，
          这样启动过程中即使点击别处也不会丢掉进度信息，
          且不会遮挡按钮本身。
        -->
        <TeachingTip x:Name="LaunchStatusTip"
                     Target="{x:Bind LaunchButton}"
                     PreferredPlacement="Top"
                     IsLightDismissEnabled="False"
                     IsOpen="{Binding IsBusy, Mode=OneWay}"
                     Title="正在启动游戏">
            <StackPanel Spacing="8" MinWidth="240">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Height="4"
                             CornerRadius="2" />
            </StackPanel>
        </TeachingTip>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App1.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:App1.Models"
    xmlns:converters="using:App1.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="PageRoot"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 标题 ==================== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Button Click="OnBackClick" ToolTipService.ToolTip="返回模组页">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    <TextBlock Text="返回" />
                </StackPanel>
            </Button>
            <TextBlock Text="搜索资源"
                       Style="{StaticResource PageTitleStyle}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- ==================== 检索条件 ==================== -->
        <Border Grid.Row="1" Style="{StaticResource SettingsCardStyle}" Padding="14,12,14,10">
            <StackPanel Spacing="10">

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <TextBox PlaceholderText="输入关键词：模组名、作者、功能描述…"
                                 Text="{Binding Query, Mode=TwoWay}"
                                 KeyDown="OnSearchKeyDown"
                                 Height="32"
                                 Padding="32,0,8,0" />
                        <FontIcon Glyph="&#xE721;"
                                  FontSize="14"
                                  Margin="10,0,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Button Grid.Column="1"
                            Height="32"
                            Click="OnSearchClick"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE721;" FontSize="13" />
                            <TextBlock Text="搜索" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 筛选与排序：含义由当前值 + 悬停提示表达 -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="136" />
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="128" />
                        <ColumnDefinition Width="124" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              Height="32" MinHeight="32"
                              ToolTipService.ToolTip="数据来源"
                              SelectedIndex="{Binding PlatformIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Modrinth" />
                        <ComboBoxItem Content="CurseForge" />
                    </ComboBox>

                    <ComboBox Grid.Column="1"
                              Height="32" MinHeight="32"
                              ToolTipService.ToolTip="资源类型"
                              SelectedIndex="{Binding TypeIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="模组" />
                        <ComboBoxItem Content="整合包" />
                        <ComboBoxItem Content="光影" />
                        <ComboBoxItem Content="材质包" />
                    </ComboBox>

                    <ComboBox Grid.Column="2"
                              Height="32" MinHeight="32"
                              ToolTipService.ToolTip="分类（中文）"
                              ItemsSource="{Binding Categories}"
                              SelectedIndex="{Binding CategoryIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />

                    <ComboBox Grid.Column="3"
                              Height="32" MinHeight="32"
                              ToolTipService.ToolTip="模组加载器"
                              SelectedItem="{Binding SelectedLoader, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <x:String>Any</x:String>
                        <x:String>Fabric</x:String>
                        <x:String>Forge</x:String>
                        <x:String>Quilt</x:String>
                        <x:String>NeoForge</x:String>
                    </ComboBox>

                    <ComboBox Grid.Column="4"
                              Height="32" MinHeight="32"
                              ToolTipService.ToolTip="目标游戏版本"
                              ItemsSource="{Binding GameVersions}"
                              SelectedItem="{Binding SelectedGameVersion, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />

                    <ComboBox Grid.Column="5"
                              Height="32" MinHeight="32"
                              ToolTipService.ToolTip="排序方式"
                              SelectedIndex="{Binding SortIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="相关度" />
                        <ComboBoxItem Content="下载量" />
                        <ComboBoxItem Content="关注数" />
                        <ComboBoxItem Content="最近更新" />
                    </ComboBox>

                    <ComboBox Grid.Column="6"
                              Height="32" MinHeight="32"
                              ToolTipService.ToolTip="安装到哪个游戏版本"
                              ItemsSource="{Binding Instances}"
                              SelectedItem="{Binding TargetInstance, Mode=TwoWay}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:GameInstance">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </Border>

        <!-- ==================== 检索结果 ==================== -->
        <Border Grid.Row="2" Style="{StaticResource SettingsCardStyle}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressRing Grid.Row="0"
                              IsActive="{Binding IsBusy}"
                              Width="36" Height="36"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />

                <GridView x:Name="ResultGrid"
                          Grid.Row="0"
                          ItemsSource="{Binding Results}"
                          ItemTemplate="{StaticResource ResourceCardTemplate}"
                          IsItemClickEnabled="True"
                          ItemClick="OnResultItemClick"
                          SelectionMode="None"
                          Background="Transparent"
                          Padding="2" />

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,2">
                    <Button Content="首页" Command="{Binding FirstPageCommand}" />
                    <Button Content="上一页" Command="{Binding PrevPageCommand}" />
                    <Border Style="{StaticResource PillStyle}" Padding="14,4,14,4">
                        <TextBlock Text="{Binding PageText}" Style="{StaticResource PillTextStyle}" />
                    </Border>
                    <Button Content="下一页" Command="{Binding NextPageCommand}" />
                    <Button Content="末页" Command="{Binding LastPageCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
